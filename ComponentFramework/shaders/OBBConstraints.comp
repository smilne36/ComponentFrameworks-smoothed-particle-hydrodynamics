#version 450
layout(local_size_x = 256) in;

struct Particle {
    vec4 pos;
    vec4 vel;
    vec4 acc;
    float density;
    float pressure;
    float padA;
    float padB;
    int isGhost;
    int isActive;
    int padC;
    int pad0;
};

layout(std430, binding=0) buffer Particles { Particle particles[]; };

uniform vec3 uBoxCenter;
uniform vec3 uBoxHalf;      // box: half extents | sphere: x=radius | cylinder: x=radius, y=half height
                            // torus: x=ring radius, y=tube radius | capsule: x=radius, y=core half length
                            // hourglass: x=base radius, y=half height, z=neck radius | egg: x=XZ semi-axis, y=Y semi-axis
uniform mat3 uBoxRot;    // column-major, world_from_box
uniform float uRestitution; // 0..1
uniform float uFriction;    // 0..1
uniform int  uShapeType;    // 0=box, 1=sphere, 2=cylinder, 3=torus, 4=capsule, 5=hourglass, 6=egg
                            // 7=star prism, 8=superellipsoid, 9=trefoil knot
uniform vec3 uShapeAux;     // star: x=points, y=depth | superellipsoid: z=exponent

// Convert world to box-local (R^T*(p-c))
vec3 worldToLocal(vec3 p) {
    vec3 d = p - uBoxCenter;
    // uBoxRot is world_from_box, so local_from_world = transpose(uBoxRot)
    return vec3(dot(d, uBoxRot[0]), dot(d, uBoxRot[1]), dot(d, uBoxRot[2]));
}
vec3 localToWorld(vec3 q) {
    return uBoxCenter + uBoxRot * q;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= particles.length()) return;

    // Skip ghosts
    if (particles[i].isGhost != 0) return;

    vec3 pW = particles[i].pos.xyz;
    vec3 vW = particles[i].vel.xyz;

    // Transform to container local space
    vec3 pL = worldToLocal(pW);

    // Project the particle back inside the container (per shape) and get the
    // outward contact normal in local space.
    vec3 qL = pL;
    vec3 nL = vec3(0.0);
    bool hit = false;

    if (uShapeType == 1) {
        // Sphere: radius = uBoxHalf.x
        float R = uBoxHalf.x;
        float d = length(pL);
        if (d > R) {
            nL = (d > 1e-6) ? pL / d : vec3(0.0, 1.0, 0.0);
            qL = nL * R;
            hit = true;
        }
    } else if (uShapeType == 2) {
        // Cylinder along local Y: radius = uBoxHalf.x, half height = uBoxHalf.y
        float R = uBoxHalf.x;
        float H = uBoxHalf.y;
        vec2 radXZ = pL.xz;
        float rad = length(radXZ);
        vec2 qXZ = (rad > R) ? radXZ * (R / max(rad, 1e-6)) : radXZ;
        qL = vec3(qXZ.x, clamp(pL.y, -H, H), qXZ.y);
        vec3 delta = pL - qL;
        float dl = length(delta);
        if (dl > 1e-6) {
            nL = delta / dl;   // exact closest-feature normal (convex shape)
            hit = true;
        }
    } else if (uShapeType == 3) {
        // Torus around local Y: ring radius R = uBoxHalf.x, tube radius r = uBoxHalf.y.
        // Closest point on the ring circle, then radial projection onto the tube.
        float R = uBoxHalf.x;
        float r = uBoxHalf.y;
        float lxz = length(pL.xz);
        vec2  ringDir = (lxz > 1e-6) ? pL.xz / lxz : vec2(1.0, 0.0); // on the hole axis: pick +X
        vec3  ring = vec3(ringDir.x * R, 0.0, ringDir.y * R);
        vec3  d  = pL - ring;
        float dl = length(d);
        if (dl > r) {
            nL  = d / max(dl, 1e-6);
            qL  = ring + nL * r;
            hit = true;
        }
    } else if (uShapeType == 4) {
        // Capsule along local Y: radius = uBoxHalf.x, cylindrical-core half length = uBoxHalf.y.
        // Closest point on the core segment, then radial projection like the sphere.
        float R = uBoxHalf.x;
        float H = uBoxHalf.y;
        vec3  seg = vec3(0.0, clamp(pL.y, -H, H), 0.0);
        vec3  d   = pL - seg;
        float dl  = length(d);
        if (dl > R) {
            nL  = d / max(dl, 1e-6);
            qL  = seg + nL * R;
            hit = true;
        }
    } else if (uShapeType == 5) {
        // Hourglass: two truncated cones tip-to-tip along local Y.
        // uBoxHalf.x = base radius, uBoxHalf.y = half height, uBoxHalf.z = neck radius.
        // Wall radius grows linearly from the neck (y=0) to the bases (y=+-H);
        // clamp y then radius, normal from the clamp delta (cylinder convention).
        float baseR = uBoxHalf.x;
        float H     = max(uBoxHalf.y, 1e-6);
        float neckR = min(uBoxHalf.z, baseR);
        float yC    = clamp(pL.y, -H, H);
        float rMax  = neckR + (baseR - neckR) * abs(yC) / H;
        float lxz   = length(pL.xz);
        vec2  qXZ   = (lxz > rMax) ? pL.xz * (rMax / max(lxz, 1e-6)) : pL.xz;
        qL = vec3(qXZ.x, yC, qXZ.y);
        vec3  delta = pL - qL;
        float dl    = length(delta);
        if (dl > 1e-6) {
            nL  = delta / dl;
            hit = true;
        }
    } else if (uShapeType == 6) {
        // Egg (ellipsoid): XZ semi-axis a = uBoxHalf.x, Y semi-axis b = uBoxHalf.y.
        // Scaled-space projection (approximate closest point); the normal is the
        // exact outward surface gradient at the projected point.
        float a = max(uBoxHalf.x, 1e-6);
        float b = max(uBoxHalf.y, 1e-6);
        vec3  e = vec3(a, b, a);
        vec3  u = pL / e;                    // unit-sphere space
        float d = length(u);
        if (d > 1.0) {
            qL  = (u / d) * e;
            nL  = normalize(qL / (e * e));
            hit = true;
        }
    } else if (uShapeType == 7) {
        // Star prism along local Y: wall radius oscillates with angle.
        // uBoxHalf.x = outer radius, .y = half height;
        // uShapeAux.x = point count, .y = depth (0..0.9).
        float R     = uBoxHalf.x;
        float H     = uBoxHalf.y;
        float pts   = max(3.0, uShapeAux.x);
        float depth = clamp(uShapeAux.y, 0.0, 0.9);
        float yC    = clamp(pL.y, -H, H);
        float ang   = atan(pL.z, pL.x);
        float rMax  = R * (1.0 - depth * (0.5 + 0.5 * cos(pts * ang)));
        float lxz   = length(pL.xz);
        vec2  qXZ   = (lxz > rMax) ? pL.xz * (rMax / max(lxz, 1e-6)) : pL.xz;
        qL = vec3(qXZ.x, yC, qXZ.y);
        vec3  delta = pL - qL;
        float dl    = length(delta);
        if (dl > 1e-6) {
            nL  = delta / dl;
            hit = true;
        }
    } else if (uShapeType == 8) {
        // Superellipsoid: |x/a|^n + |y/b|^n + |z/a|^n = 1. The exponent morphs
        // the family: ~1 diamond, 2 sphere, 4+ rounded cube. Radial projection
        // is exact for this implicit (F(k*p) = k^n * F(p)); gradient normal.
        float a = max(uBoxHalf.x, 1e-6);
        float b = max(uBoxHalf.y, 1e-6);
        float n = clamp(uShapeAux.z, 0.6, 8.0);
        vec3  e = vec3(a, b, a);
        vec3  u = abs(pL) / e;
        float F = pow(u.x, n) + pow(u.y, n) + pow(u.z, n);
        if (F > 1.0) {
            qL = pL * pow(F, -1.0 / n);
            vec3 g = sign(pL) * pow(max(abs(qL) / e, vec3(1e-6)), vec3(n - 1.0)) / e;
            nL  = normalize(g);
            hit = true;
        }
    } else if (uShapeType == 9) {
        // Trefoil knot tube: nearest of 48 samples along the knot curve, then
        // radial projection onto the tube. uBoxHalf.x = knot scale, .y = tube r.
        float S = uBoxHalf.x;
        float r = uBoxHalf.y;
        vec3  best   = vec3(3.0 * S, 0.0, 0.0);
        float bestD2 = 1e30;
        for (int k = 0; k < 48; ++k) {
            float t = 6.2831853 * float(k) / 48.0;
            vec3 c = S * vec3(sin(t) + 2.0 * sin(2.0 * t),
                              0.35 * (-sin(3.0 * t)),
                              cos(t) - 2.0 * cos(2.0 * t));
            vec3  d  = pL - c;
            float d2 = dot(d, d);
            if (d2 < bestD2) { bestD2 = d2; best = c; }
        }
        vec3  d  = pL - best;
        float dl = length(d);
        if (dl > r) {
            nL  = d / max(dl, 1e-6);
            qL  = best + nL * r;
            hit = true;
        }
    } else if (uShapeType == 10) {
        // Mobius band: a flat band around a circle whose cross-section rotates a
        // half-turn over the loop. uBoxHalf.x = ring radius, .y = band half-width,
        // uShapeAux.x = band half-thickness.
        float R     = uBoxHalf.x;
        float wHalf = uBoxHalf.y;
        float tHalf = max(uShapeAux.x, 0.05);
        float phi   = atan(pL.z, pL.x);
        vec3  c     = R * vec3(cos(phi), 0.0, sin(phi));
        vec3  er    = vec3(cos(phi), 0.0, sin(phi));   // radial (cross-section plane with ey)
        vec3  ey    = vec3(0.0, 1.0, 0.0);
        float psi   = 0.5 * phi;                       // half twist over the full loop
        vec3  wAxis = cos(psi) * er + sin(psi) * ey;   // band width dir (twists)
        vec3  tAxis = -sin(psi) * er + cos(psi) * ey;  // band thickness dir
        vec3  o     = pL - c;
        float cu    = clamp(dot(o, wAxis), -wHalf, wHalf);
        float cv    = clamp(dot(o, tAxis), -tHalf, tHalf);
        qL = c + cu * wAxis + cv * tAxis;
        vec3  delta = pL - qL;
        float dl    = length(delta);
        if (dl > 1e-5) { nL = delta / dl; hit = true; }
    } else if (uShapeType == 11) {
        // DNA double helix: two helical tubes offset by half a turn. Nearest of
        // 64 samples on each strand. uBoxHalf.x = radius, .y = tube r,
        // uShapeAux.x = turns, uShapeAux.y = half height.
        float R = uBoxHalf.x, r = uBoxHalf.y;
        float turns = max(1.0, uShapeAux.x), H = max(uShapeAux.y, r);
        vec3  best = vec3(R, -H, 0.0); float bestD2 = 1e30;
        for (int k = 0; k < 64; ++k) {
            float f = float(k) / 63.0;
            float t = f * turns * 6.2831853;
            float y = (f - 0.5) * 2.0 * H;
            vec3 c1 = vec3(R * cos(t), y, R * sin(t));
            vec3 c2 = vec3(R * cos(t + 3.14159265), y, R * sin(t + 3.14159265));
            vec3 d1 = pL - c1; float e1 = dot(d1, d1); if (e1 < bestD2) { bestD2 = e1; best = c1; }
            vec3 d2 = pL - c2; float e2 = dot(d2, d2); if (e2 < bestD2) { bestD2 = e2; best = c2; }
        }
        vec3 d = pL - best; float dl = length(d);
        if (dl > r) { nL = d / max(dl, 1e-6); qL = best + nL * r; hit = true; }
    } else if (uShapeType == 12) {
        // Heart: a heart-outline tube ring in the XY plane (glowing heart wire).
        // uBoxHalf.x = size, .y = tube r.
        float S = uBoxHalf.x * 0.0625, r = uBoxHalf.y;   // heart param spans ~16 units
        vec3  best = vec3(0.0); float bestD2 = 1e30;
        for (int k = 0; k < 64; ++k) {
            float t  = 6.2831853 * float(k) / 64.0;
            float st = sin(t);
            float hx = 16.0 * st * st * st;
            float hy = 13.0 * cos(t) - 5.0 * cos(2.0 * t) - 2.0 * cos(3.0 * t) - cos(4.0 * t);
            vec3  cc = vec3(S * hx, S * hy, 0.0);
            vec3  dd = pL - cc; float d2 = dot(dd, dd);
            if (d2 < bestD2) { bestD2 = d2; best = cc; }
        }
        vec3 d = pL - best; float dl = length(d);
        if (dl > r) { nL = d / max(dl, 1e-6); qL = best + nL * r; hit = true; }
    } else if (uShapeType == 13) {
        // Gyroid: fluid fills the gyroid channel network inside a bounding
        // sphere. uBoxHalf.x = sphere R, uShapeAux.x = cell frequency,
        // uShapeAux.y = channel half-thickness.
        float R  = uBoxHalf.x;
        float sc = max(uShapeAux.x, 0.1);
        float th = clamp(uShapeAux.y, 0.2, 2.5);
        float lp = length(pL);
        if (lp > R) {
            nL = pL / max(lp, 1e-6); qL = nL * R; hit = true;
        } else {
            vec3  q = pL * sc;
            float g = sin(q.x) * cos(q.y) + sin(q.y) * cos(q.z) + sin(q.z) * cos(q.x);
            if (abs(g) > th) {
                vec3 grad = sc * vec3(
                    cos(q.x) * cos(q.y) - sin(q.z) * sin(q.x),
                   -sin(q.x) * sin(q.y) + cos(q.y) * cos(q.z),
                   -sin(q.y) * sin(q.z) + cos(q.z) * cos(q.x));
                float gl = max(length(grad), 1e-5);
                nL = sign(g) * grad / gl;
                qL = pL - nL * ((abs(g) - th) / gl);
                hit = true;
            }
        }
    } else if (uShapeType == 14) {
        // Coil / spring: a vertical helical tube. uBoxHalf.x = coil radius,
        // .y = tube r, uShapeAux.x = turns, uShapeAux.y = half height.
        float R = uBoxHalf.x, r = uBoxHalf.y;
        float turns = max(1.0, uShapeAux.x), H = max(uShapeAux.y, r);
        vec3  best = vec3(R, -H, 0.0); float bestD2 = 1e30;
        for (int k = 0; k < 64; ++k) {
            float f = float(k) / 63.0;
            float t = f * turns * 6.2831853;
            vec3  cc = vec3(R * cos(t), (f - 0.5) * 2.0 * H, R * sin(t));
            vec3  dd = pL - cc; float d2 = dot(dd, dd);
            if (d2 < bestD2) { bestD2 = d2; best = cc; }
        }
        vec3 d = pL - best; float dl = length(d);
        if (dl > r) { nL = d / max(dl, 1e-6); qL = best + nL * r; hit = true; }
    } else {
        // Box: clamp to the OBB AABB in local space
        qL = clamp(pL, -uBoxHalf, uBoxHalf);
        vec3 delta = pL - qL;
        if (any(greaterThan(abs(delta), vec3(0.0)))) {
            // Contact normal along the most violated axis (in local space)
            vec3 d = abs(delta);
            if (d.x >= d.y && d.x >= d.z) nL = vec3(sign(delta.x), 0.0, 0.0);
            else if (d.y >= d.x && d.y >= d.z) nL = vec3(0.0, sign(delta.y), 0.0);
            else nL = vec3(0.0, 0.0, sign(delta.z));
            hit = true;
        }
    }

    if (hit) {
        // Transform normal to world
        vec3 nW = normalize(uBoxRot * nL);

        // Correct position to the surface
        pW = localToWorld(qL);

        // Split velocity into normal/tangent and reflect with restitution + friction
        float vn = dot(vW, nW);
        vec3 vN = vn * nW;
        vec3 vT = vW - vN;

        vec3 vN_new = -uRestitution * vN;
        vec3 vT_new = (1.0 - uFriction) * vT;

        vW = vN_new + vT_new;
    }

    particles[i].pos.xyz = pW;
    particles[i].vel.xyz = vW;
}